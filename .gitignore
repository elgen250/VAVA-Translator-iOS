# Xcode
#
# gitignore template for Xcode programs
# website: https://www.toptal.com/developers/gitignore/api/xcode

.DS_Store
*/.DS_Store

# Xcode project and workspace user state
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/

# Xcode generated files
*.moved-aside
*.xccheckout
*.xcscmblueprint

# Xcode Gen generated projects (regenerated from project.yml)
*.xcodeproj/
!project.yml

# DerivedData
DerivedData/

# Swift Package Manager
.build/
Packages/
Package.pins
Package.resolved

# Fastlane & Artifacts
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
Payload/
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM
